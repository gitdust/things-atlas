{
  "name": "things-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Things Atlas / 日常之物图志 — world map + time scrubber for everyday objects",
  "scripts": {
    "dev": "npm run build:data && vite",
    "validate": "tsx scripts/validate-items.ts",
    "build:data": "tsx scripts/build-index.ts",
    "new-item": "tsx scripts/new-item.ts",
    "build": "npm run validate && npm run build:data && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.1"
  }
}
