{
  "name": "things-atlas",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Things Atlas / 日常之物图志 — world map + time scrubber for everyday objects",
  "scripts": {
    "dev": "npm run build:data && npm run build:quiz && npm run build:share && vite",
    "validate": "tsx scripts/validate-items.ts && tsx scripts/build-fonts.ts --check",
    "build:data": "tsx scripts/build-index.ts",
    "new-item": "tsx scripts/new-item.ts",
    "images": "tsx scripts/build-images.ts && npm run build:data",
    "fonts": "tsx scripts/build-fonts.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . && tsx scripts/check-tokens.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run validate && npm run build:data && npm run build:quiz && npm run build:share && tsx scripts/release-notes.ts --write && npm run typecheck && vite build && tsx scripts/prerender.ts && npm run test:share:assets",
    "preview": "vite preview",
    "test:updates": "node --import tsx --test scripts/release-notes.test.ts",
    "test:geo": "node --import tsx --test scripts/geo-arcs.test.ts",
    "build:share": "node --import tsx scripts/build-share-images.ts",
    "test:share": "node --import tsx --test scripts/share.test.ts",
    "test:share:assets": "node --import tsx scripts/check-share-assets.ts",
    "build:quiz": "tsx scripts/build-quiz.ts",
    "test:quiz": "node --import tsx --test scripts/quiz.test.ts scripts/quiz-lifecycle.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "sharp": "^0.34.5",
    "subset-font": "^2.9.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.1"
  }
}
