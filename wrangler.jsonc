{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "things-atlas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
