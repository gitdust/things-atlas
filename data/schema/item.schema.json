{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://things-atlas.com/schemas/item.schema.json",
  "title": "ThingsAtlasItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name_zh",
    "name_en",
    "category",
    "years",
    "locations",
    "confidence",
    "sources",
    "disputed",
    "summary_zh",
    "summary_en",
    "tags",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name_zh": { "type": "string", "minLength": 1 },
    "name_en": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": [
        "stationery",
        "apparel_accessory",
        "hand_tool",
        "home",
        "personal_care",
        "digital",
        "kitchen"
      ]
    },
    "years": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invention", "patent", "mass_production", "popularization"],
      "properties": {
        "invention": { "$ref": "#/$defs/yearMarkOrNull" },
        "patent": { "$ref": "#/$defs/yearMarkOrNull" },
        "mass_production": { "$ref": "#/$defs/yearMarkOrNull" },
        "popularization": { "$ref": "#/$defs/yearMarkOrNull" }
      }
    },
    "primary": {
      "description": "Optional. Which years.* mark is the derived primary_year; must point to a non-null mark. When unset: invention → patent → mass_production → popularization (first non-null).",
      "type": "string",
      "enum": ["invention", "patent", "mass_production", "popularization"]
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/location" }
    },
    "confidence": {
      "type": "string",
      "enum": ["exact", "year", "decade", "century", "disputed"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "disputed": { "type": "boolean" },
    "notes": { "type": "string", "description": "Chinese dispute / editorial note. Required (≥40 chars) when disputed=true; shown in the drawer only for disputed entries." },
    "notes_en": { "type": "string", "description": "English dispute / editorial note. Required when disputed=true; shown in the drawer only for disputed entries." },
    "image": {
      "description": "Optional illustrative photo shown in the item drawer. Prefer a local path under /images/.",
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt_zh", "alt_en"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt_zh": { "type": "string", "minLength": 1 },
        "alt_en": { "type": "string", "minLength": 1 },
        "credit": { "type": "string" },
        "license": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" }
      }
    },
    "share": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "zh": {
          "$ref": "#/$defs/shareLocale"
        },
        "en": {
          "$ref": "#/$defs/shareLocale"
        }
      }
    },
    "summary_zh": { "type": "string", "minLength": 1, "maxLength": 160 },
    "summary_en": { "type": "string", "minLength": 1, "maxLength": 200 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "updated": {
      "type": "string",
      "format": "date"
    }
  },
  "$defs": {
    "shareLocale": {
      "type": "object",
      "required": [
        "summary",
        "ogSummary"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "ogSummary": {
          "type": "string",
          "minLength": 1
        },
        "milestones": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "yearKey",
              "label",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "yearKey": {
                "enum": [
                  "invention",
                  "patent",
                  "mass_production",
                  "popularization"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "yearMarkOrNull": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/yearMark" }
      ]
    },
    "yearMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "precision"],
      "properties": {
        "year": { "type": "integer", "minimum": -7000, "maximum": 2100 },
        "precision": {
          "type": "string",
          "enum": ["exact", "year", "decade", "century"]
        },
        "ref": { "type": "string", "description": "English note for this year mark (shown when UI is EN)." },
        "ref_zh": { "type": "string", "description": "Chinese note for this year mark (shown when UI is ZH)." }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng",
        "place_label_zh",
        "place_label_en",
        "kind",
        "confidence"
      ],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "place_label_zh": { "type": "string", "minLength": 1 },
        "place_label_en": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "invention",
            "patent",
            "production",
            "popularization",
            "contested"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": ["exact", "city", "region", "country", "approximate"]
        },
        "year_override": {
          "type": "integer",
          "minimum": -7000,
          "maximum": 2100
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "type", "accessed"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "type": {
          "type": "string",
          "enum": [
            "patent",
            "museum",
            "wiki",
            "book",
            "news",
            "brand",
            "other"
          ]
        },
        "accessed": { "type": "string", "format": "date" }
      }
    }
  }
}
